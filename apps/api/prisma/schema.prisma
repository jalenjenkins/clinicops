generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  sku          String   @unique
  quantity     Int      @default(0)
  reorderPoint Int      @default(10)
  price        Float
  category     String   @default("General")
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferredVendorId Int?
  preferredVendor   Vendor? @relation(fields: [preferredVendorId], references: [id])

  purchaseOrderItems PurchaseOrderItem[]
  movements          StockMovement[]
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  purchaseOrders    PurchaseOrder[]
  preferredProducts Product[]
}

model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  vendorId    Int
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  receivedAt  DateTime?

  vendor Vendor              @relation(fields: [vendorId], references: [id])
  items  PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              Int   @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Int
  unitPrice       Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
}

// Append-only audit trail: every change to on-hand quantity writes one row.
// type: INITIAL | RECEIPT | USAGE | ADJUSTMENT
model StockMovement {
  id            Int      @id @default(autoincrement())
  productId     Int
  type          String
  delta         Int
  quantityAfter Int
  note          String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([createdAt])
}