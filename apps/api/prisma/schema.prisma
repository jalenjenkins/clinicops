generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  sku          String   @unique
  quantity     Int      @default(0)
  reorderPoint Int      @default(10)
  price        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}